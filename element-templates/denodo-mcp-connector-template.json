{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Denodo MCP Connector",
  "id": "com.denodo.connectors.mcp.remoteclient.v1",
  "description": "Connect an AI agent to a Denodo Virtual DataPort database via its built-in MCP server, so the agent can discover and query Denodo views as tools.",
  "documentationRef": "https://community.denodo.com/docs/html/browse/latest/en/vdp/developer/model_context_protocol_mcp/model_context_protocol_mcp",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "endpoint",
      "label": "Denodo connection"
    },
    {
      "id": "authentication",
      "label": "Authentication"
    },
    {
      "id": "options",
      "label": "Options"
    },
    {
      "id": "output",
      "label": "Output mapping"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.camunda.agenticai:mcpremoteclient:1",
      "binding": {
        "type": "zeebe:taskDefinition:type"
      }
    },
    {
      "label": "Retries",
      "type": "String",
      "value": "3",
      "group": "options",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "retries"
      }
    },
    {
      "type": "Hidden",
      "value": "http",
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.type"
      }
    },
    {
      "label": "Transport type",
      "type": "Dropdown",
      "group": "endpoint",
      "value": "streamable-http",
      "choices": [
        {
          "name": "Streamable HTTP (recommended)",
          "value": "streamable-http"
        },
        {
          "name": "HTTP with SSE (legacy, deprecated by Denodo)",
          "value": "sse"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.mode"
      },
      "description": "Denodo recommends Streamable HTTP for new integrations. SSE is supported only for backward compatibility."
    },
    {
      "label": "Denodo MCP server URL",
      "type": "String",
      "group": "endpoint",
      "constraints": {
        "notEmpty": true
      },
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.url"
      },
      "description": "Full URL to your Denodo MCP endpoint, in the form https://<denodo-host>:<port>/<vdb-name>/mcp \u2014 for example https://denodo.mycompany.com:9090/sales/mcp."
    },
    {
      "id": "authType",
      "label": "Authentication type",
      "type": "Dropdown",
      "group": "authentication",
      "value": "basic",
      "choices": [
        {
          "name": "None",
          "value": "none"
        },
        {
          "name": "Basic (username / password)",
          "value": "basic"
        },
        {
          "name": "OAuth 2.0",
          "value": "oauth2"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.type"
      },
      "description": "Match this to how your Denodo administrator configured MCP server authentication."
    },
    {
      "label": "Username",
      "type": "String",
      "group": "authentication",
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.username"
      },
      "condition": {
        "property": "authType",
        "equals": "basic"
      }
    },
    {
      "label": "Password",
      "type": "String",
      "group": "authentication",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.password"
      },
      "condition": {
        "property": "authType",
        "equals": "basic"
      },
      "description": "Reference a Camunda secret instead of a plaintext password, e.g. {{secrets.DENODO_PASSWORD}}."
    },
    {
      "label": "OAuth 2.0 Token URL",
      "type": "String",
      "group": "authentication",
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.oauth2.tokenUrl"
      },
      "condition": {
        "property": "authType",
        "equals": "oauth2"
      }
    },
    {
      "label": "Client ID",
      "type": "String",
      "group": "authentication",
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.oauth2.clientId"
      },
      "condition": {
        "property": "authType",
        "equals": "oauth2"
      }
    },
    {
      "label": "Client Secret",
      "type": "String",
      "group": "authentication",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.oauth2.clientSecret"
      },
      "condition": {
        "property": "authType",
        "equals": "oauth2"
      },
      "description": "Reference a Camunda secret instead of a plaintext value, e.g. {{secrets.DENODO_OAUTH_CLIENT_SECRET}}."
    },
    {
      "label": "Scope",
      "type": "String",
      "group": "authentication",
      "optional": true,
      "binding": {
        "type": "zeebe:input",
        "name": "data.transport.http.authentication.oauth2.scope"
      },
      "condition": {
        "property": "authType",
        "equals": "oauth2"
      }
    },
    {
      "type": "Hidden",
      "value": "false",
      "binding": {
        "type": "zeebe:input",
        "name": "data.options.clientCache"
      }
    },
    {
      "type": "Hidden",
      "value": "aiAgentTool",
      "binding": {
        "type": "zeebe:input",
        "name": "data.connectorMode.type"
      }
    },
    {
      "type": "Hidden",
      "value": "=toolCall.method",
      "binding": {
        "type": "zeebe:input",
        "name": "data.connectorMode.toolOperation.method"
      }
    },
    {
      "type": "Hidden",
      "value": "=toolCall.params",
      "binding": {
        "type": "zeebe:input",
        "name": "data.connectorMode.toolOperation.params"
      }
    },
    {
      "type": "Hidden",
      "value": "mcpClient",
      "binding": {
        "type": "zeebe:property",
        "name": "io.camunda.agenticai.gateway.type"
      }
    },
    {
      "label": "Result variable",
      "type": "String",
      "group": "output",
      "value": "toolCallResult",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultVariable"
      }
    },
    {
      "label": "Retry backoff",
      "type": "String",
      "group": "output",
      "value": "PT30S",
      "optional": true,
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "retryBackoff"
      },
      "description": "ISO-8601 duration to wait before retrying a failed call, e.g. PT30S for 30 seconds."
    }
  ],
  "icon": {
    "contents": "data:image/png;base64,"
  }
}