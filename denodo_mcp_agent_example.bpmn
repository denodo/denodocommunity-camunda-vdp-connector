<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_DenodoMcpExample" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_DenodoMcpAgent" name="Denodo MCP Agent" isExecutable="true">
    <bpmn:startEvent id="StartEvent_UserQuestion" name="User question received">
      <bpmn:outgoing>Flow_StartToAgent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartToAgent" sourceRef="StartEvent_UserQuestion" targetRef="Activity_AiAgent" />
    <bpmn:adHocSubProcess id="Activity_AiAgent" name="AI Agent (with Denodo tool)" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="{{secrets.OPENAI_API_KEY}}" target="provider.openai.authentication.apiKey" />
          <zeebe:input source="&#60;YOUR_MODEL_NAME&#62;" target="provider.openai.model.model" />
          <zeebe:input source="=&#34;You are a helpful assistant with access to tools for querying a Denodo database. Use the available tools to answer the user&#39;s question. If no tool is relevant, answer from your own knowledge or explain why you cannot.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=userQuestion" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=false" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentToEnd</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_QueryDenodoSales" name="Query Denodo (sales database)" zeebe:modelerTemplate="com.denodo.connectors.mcp.remoteclient.v1" zeebe:modelerTemplateIcon="data:image/png;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda.agenticai:mcpremoteclient:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="http" target="data.transport.type" />
            <zeebe:input source="streamable-http" target="data.transport.http.mode" />
            <zeebe:input source="https://your-denodo-host.example.com:9090/sales/mcp" target="data.transport.http.url" />
            <zeebe:input source="basic" target="data.transport.http.authentication.type" />
            <zeebe:input source="{{secrets.DENODO_USERNAME}}" target="data.transport.http.authentication.username" />
            <zeebe:input source="{{secrets.DENODO_PASSWORD}}" target="data.transport.http.authentication.password" />
            <zeebe:input source="false" target="data.options.clientCache" />
            <zeebe:input source="aiAgentTool" target="data.connectorMode.type" />
            <zeebe:input source="=toolCall.method" target="data.connectorMode.toolOperation.method" />
            <zeebe:input source="=toolCall.params" target="data.connectorMode.toolOperation.params" />
          </zeebe:ioMapping>
          <zeebe:properties>
            <zeebe:property name="io.camunda.agenticai.gateway.type" value="mcpClient" />
          </zeebe:properties>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_AgentToEnd" sourceRef="Activity_AiAgent" targetRef="Event_Done" />
    <bpmn:intermediateThrowEvent id="Event_Done" name="Answer ready">
      <bpmn:incoming>Flow_AgentToEnd</bpmn:incoming>
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_DenodoMcpAgent">
      <bpmndi:BPMNShape id="StartEvent_UserQuestion_di" bpmnElement="StartEvent_UserQuestion">
        <dc:Bounds x="152" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_AiAgent_di" bpmnElement="Activity_AiAgent" isExpanded="true">
        <dc:Bounds x="280" y="80" width="350" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_QueryDenodoSales_di" bpmnElement="Activity_QueryDenodoSales">
        <dc:Bounds x="405" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Done_di" bpmnElement="Event_Done">
        <dc:Bounds x="722" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToAgent_di" bpmnElement="Flow_StartToAgent">
        <di:waypoint x="188" y="150" />
        <di:waypoint x="280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentToEnd_di" bpmnElement="Flow_AgentToEnd">
        <di:waypoint x="630" y="180" />
        <di:waypoint x="722" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
